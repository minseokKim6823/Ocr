# ==============================================================================
# .env.example — Environment variable reference for ocr-gemma
# ==============================================================================
# Copy this file to .env and uncomment / adjust values for your setup.
# The package reads these via os.environ (or python-dotenv if installed).
#
#   cp .env.example .env   (Linux/Mac/WSL)
#   Copy-Item .env.example .env   (PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# OCR_BACKEND
#   Which inference backend to use.
#   Options: ollama | transformers | vllm
#   Default: ollama
# ------------------------------------------------------------------------------
# OCR_BACKEND=ollama

# ------------------------------------------------------------------------------
# OCR_MODEL
#   Model identifier, interpreted by the active backend:
#     ollama      → Ollama model tag,  e.g. gemma4:e2b  or  gemma4:e4b
#     transformers→ HuggingFace repo,  e.g. google/gemma-4-e4b-it
#     vllm        → same HF repo or local path
#   Default (ollama): gemma4:e2b
#   Default (transformers/vllm): google/gemma-4-e4b-it
# ------------------------------------------------------------------------------
# OCR_MODEL=gemma4:e2b

# ------------------------------------------------------------------------------
# OCR_DEVICE
#   Compute device for the transformers / vllm backends (ignored by ollama).
#   Options: cpu | cuda | auto
#   Default: auto  (lets accelerate choose the best available device)
# ------------------------------------------------------------------------------
# OCR_DEVICE=auto

# ------------------------------------------------------------------------------
# OCR_NUM_THREADS
#   Number of CPU threads for torch / Ollama inference.
#   Leave unset to use the runtime default (usually all physical cores).
# ------------------------------------------------------------------------------
# OCR_NUM_THREADS=4

# ------------------------------------------------------------------------------
# OCR_MAX_NEW_TOKENS
#   Maximum tokens the model may generate per image/page.
#   Higher values allow longer OCR output but increase latency.
#   Default: 2048
# ------------------------------------------------------------------------------
# OCR_MAX_NEW_TOKENS=2048

# ------------------------------------------------------------------------------
# OCR_HOST
#   Base URL of the Ollama server (ollama backend only).
#   Default: http://localhost:11434
#   Change this if Ollama runs on a remote host or non-default port.
# ------------------------------------------------------------------------------
# OCR_HOST=http://localhost:11434


# ==============================================================================
# Example profiles
# ==============================================================================

# --- CPU / Ollama profile (this machine) --------------------------------------
# OCR_BACKEND=ollama
# OCR_MODEL=gemma4:e2b
# OCR_HOST=http://localhost:11434
# OCR_MAX_NEW_TOKENS=2048
# OCR_NUM_THREADS=8

# --- GPU / HuggingFace Transformers profile -----------------------------------
# OCR_BACKEND=transformers
# OCR_MODEL=google/gemma-4-e4b-it
# OCR_DEVICE=auto
# OCR_MAX_NEW_TOKENS=4096

# --- GPU / vLLM profile (Linux + CUDA) ----------------------------------------
# OCR_BACKEND=vllm
# OCR_MODEL=google/gemma-4-e4b-it
# OCR_DEVICE=cuda
# OCR_MAX_NEW_TOKENS=4096
